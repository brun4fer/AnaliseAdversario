# Neon pooled connection for the app runtime and Prisma CLI.
# The host usually includes "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/analise_adversario?sslmode=require&channel_binding=require"

# Optional Neon direct connection, useful if you run manual database tools.
# The app does not require this variable.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/analise_adversario?sslmode=require&channel_binding=require"

# Optional, only useful when deploying behind custom domains.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Use a long random value in production to sign login sessions.
AUTH_SECRET="replace-with-a-long-random-secret"

# Private Cloudflare R2 bucket used for large match videos.
R2_BUCKET_NAME="analise-adversario-prod"
R2_ENDPOINT="https://ACCOUNT_ID.eu.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
