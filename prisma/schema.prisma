generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  username  String?  @unique
  passwordHash String?
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seasons Season[]
  clubs Club[]
  competitions Competition[]
  matches Match[]
  momentTypes MomentType[]
  subMomentTypes SubMomentType[]
  shortcuts ShortcutSetting[]
}

model Season {
  id String @id @default(cuid())
  name String
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches Match[]
  competitions Competition[]
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
  @@unique([ownerId, name])
}

model Club {
  id String @id @default(cuid())
  name String
  shortName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  homeMatches Match[] @relation("HomeClub")
  awayMatches Match[] @relation("AwayClub")
  competitions Competition[]
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
  @@unique([ownerId, name])
}

model Competition {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches Match[]
  seasonId String?
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  clubs Club[]
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([ownerId])
  @@unique([seasonId, name])
}

model Match {
  id           String   @id @default(cuid())
  title        String
  teamName     String?
  opponentName String
  matchDate    DateTime?
  competition  String?
  venue        String?
  notes        String?
  roundName    String?
  seasonId     String?
  homeClubId   String?
  awayClubId   String?
  competitionId String?
  firstHalfStartSeconds  Float?
  firstHalfEndSeconds    Float?
  secondHalfStartSeconds Float?
  secondHalfEndSeconds   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  videos  Video[]
  moments Moment[]
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeClub Club? @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  awayClub Club? @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  competitionRecord Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([competitionId])
  @@index([ownerId])
}

model Video {
  id              String             @id @default(cuid())
  matchId         String
  fileName        String
  fileSize        BigInt
  durationSeconds Float
  mimeType        String
  lastModified    DateTime?
  storageType     String             @default("local")
  storageKey      String?            @unique
  storageStatus   VideoStorageStatus @default(LOCAL)
  uploadId        String?
  mediaAssetId    String?
  etag            String?
  uploadedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  moments Moment[]

  @@index([matchId])
  @@index([mediaAssetId])
}

enum VideoStorageStatus {
  LOCAL
  UPLOADING
  READY
  FAILED
}

model MomentType {
  id              String   @id @default(cuid())
  name            String
  code            String
  color           String
  defaultShortcut String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  moments Moment[]
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, code])
  @@index([ownerId])
}

model Moment {
  id               String   @id @default(cuid())
  matchId          String
  videoId          String?
  momentTypeId     String
  startTimeSeconds Float
  endTimeSeconds   Float
  durationSeconds  Float
  notes            String?
  outcome          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  video       Video?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  momentType  MomentType  @relation(fields: [momentTypeId], references: [id])
  subMoments  SubMoment[]

  @@index([matchId])
  @@index([videoId])
  @@index([momentTypeId])
}

model SubMomentType {
  id                    String   @id @default(cuid())
  name                  String
  code                  String
  requiresFieldLocation Boolean  @default(true)
  requiresGoalLocation  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subMoments SubMoment[]
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, code])
  @@index([ownerId])
}

model SubMoment {
  id              String   @id @default(cuid())
  momentId        String
  subMomentTypeId String
  timeSeconds     Float?
  fieldX          Float?
  fieldY          Float?
  goalX           Float?
  goalY           Float?
  notes           String?
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  moment        Moment        @relation(fields: [momentId], references: [id], onDelete: Cascade)
  subMomentType SubMomentType @relation(fields: [subMomentTypeId], references: [id])

  @@index([momentId])
  @@index([subMomentTypeId])
}

model ShortcutSetting {
  id         String   @id @default(cuid())
  actionType String
  targetType String
  targetId   String?
  key        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([actionType, targetType, targetId])
  @@index([ownerId])
}
